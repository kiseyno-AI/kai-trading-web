# Copy to .env.local and adjust. See README Environment section.

# Server-side proxy to trading-core (Next API routes under /api/trading)
# TRADING_API_UPSTREAM_BASE_URL=https://api.example.com
# TRADING_API_UPSTREAM_BEARER_TOKEN=

# Client adapter base (optional; omit for local mock mode. On deployments, /dashboard SSR
# will also use this when server upstream env is not set.)
# NEXT_PUBLIC_TRADING_API_BASE_URL=http://localhost:3000/api/trading
